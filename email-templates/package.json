{
  "name": "@theurbannet/waitlist-emails",
  "version": "1.0.0",
  "description": "Reusable React email components and layouts for TheUrbanNet / Urbannet",
  "type": "module",
  "scripts": {
    "dev": "email dev --dir emails",
    "render": "tsx scripts/render-all.ts",
    "typecheck": "tsc --noEmit",
